{
  "name": "tod-ai",
  "version": "0.1.0",
  "description": "An operator harness that turns any AGENTS.md-compatible coding agent into a software factory for non-technical builders.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tod": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylerhogarth/tod.git"
  },
  "homepage": "https://github.com/tylerhogarth/tod#readme",
  "bugs": "https://github.com/tylerhogarth/tod/issues",
  "keywords": [
    "agents",
    "agents-md",
    "claude-code",
    "codex",
    "coding-agents",
    "operator",
    "harness"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "build": "bun run scripts/build.ts",
    "check": "bun run typecheck && bun run lint && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "better-result": "3.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
